# ============================================
# Plastmassa CRM — Nginx Reverse Proxy
# Server: 187.77.111.100
# Domain: netpharm.uz
# ============================================
# Serverda:
#   sudo cp nginx.conf.example /etc/nginx/sites-available/netpharm.uz
#   sudo ln -s /etc/nginx/sites-available/netpharm.uz /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d netpharm.uz
# ============================================

server {
    listen 80;
    server_name netpharm.uz;

    # Frontend (React SPA)
    location / {
        proxy_pass http://127.0.0.1:6001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Backend API
    location /api/ {
        proxy_pass http://127.0.0.1:6000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Max upload size
    client_max_body_size 10M;
}
