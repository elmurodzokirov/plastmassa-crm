# ============================================
# Plastmassa CRM — Production Environment
# ============================================
# Serverda .env faylga nusxa oling:
#   cp .env.production.example apps/backend/.env
#   nano apps/backend/.env  # secretlarni to'ldiring
# ============================================

# --- App ---
NODE_ENV=production
PORT=6000

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/plastmassa_crm

# --- JWT ---
JWT_SECRET=CHANGE_ME_STRONG_RANDOM_SECRET_32_CHARS
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_STRONG_SECRET_32_CHARS
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS (vergul bilan ajratilgan domenlar) ---
CORS_ORIGINS=https://netpharm.uz,http://netpharm.uz

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3

# --- Admin Seed ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ADMIN_FULLNAME=Administrator
